              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH Base AS
(
    SELECT
        id_student,
        CAST(TRIM(gender) AS VARCHAR(1)) AS gender,
        CAST(
            COALESCE(NULLIF(TRIM(region), ''), 'Unknown')
            AS VARCHAR(50)
        ) AS region,
        CAST(
            COALESCE(NULLIF(TRIM(highest_education), ''), 'Unknown')
            AS VARCHAR(50)
        ) AS highest_education,
        CAST(
            CASE
                WHEN TRIM(imd_band) = '10-20' THEN '10-20%'
                WHEN NULLIF(TRIM(imd_band), '') IS NULL THEN 'Unknown'
                ELSE TRIM(imd_band)
            END
            AS VARCHAR(20)
        ) AS imd_band,
        CAST(TRIM(age_band) AS VARCHAR(10)) AS age_band,
        CAST(TRIM(disability) AS VARCHAR(1)) AS disability,
        CAST(code_presentation AS VARCHAR(6)) AS code_presentation
    FROM dbo.studentInfo
),
Versiones AS
(
    SELECT
        id_student,
        age_band,
        MAX(gender) AS gender,
        MAX(region) AS region,
        MAX(highest_education) AS highest_education,
        MAX(imd_band) AS imd_band,
        MAX(disability) AS disability,
        MIN(code_presentation) AS valid_from_presentation,
        MAX(code_presentation) AS ultima_presentacion
    FROM Base
    GROUP BY id_student, age_band
),
Numeradas AS
(
    SELECT *,
        ROW_NUMBER() OVER
        (
            PARTITION BY id_student
            ORDER BY valid_from_presentation, age_band
        ) AS numero_version,
        COUNT(*) OVER
        (
            PARTITION BY id_student
        ) AS total_versiones
    FROM Versiones
)
SELECT
    id_student,
    CAST(numero_version AS INT) AS version,
    CAST(valid_from_presentation AS VARCHAR(6))
        AS valid_from_presentation,
    CAST(
        CASE
            WHEN numero_version = total_versiones THEN NULL
            ELSE ultima_presentacion
        END
        AS VARCHAR(6)
    ) AS valid_to_presentation,
    CAST(gender AS VARCHAR(1)) AS gender,
    CAST(region AS VARCHAR(50)) AS region,
    CAST(highest_education AS VARCHAR(50)) AS highest_education,
    CAST(imd_band AS VARCHAR(20)) AS imd_band,
    CAST(age_band AS VARCHAR(10)) AS age_band,
    CAST(disability AS VARCHAR(1)) AS disability
FROM Numeradas;</property>
