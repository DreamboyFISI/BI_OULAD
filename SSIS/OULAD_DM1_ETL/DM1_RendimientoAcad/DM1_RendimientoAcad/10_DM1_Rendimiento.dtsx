            <component
              refId="Package\FLUJO_FACT_RESULTADO_ACAD\ORIGEN_OLAD"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
              description="Origen de OLE DB"
              name="ORIGEN_OLAD"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH EvaluacionesEsperadas AS
(
    SELECT
        code_module,
        code_presentation,
        COUNT(*) AS evaluaciones_esperadas
    FROM dbo.assessments
    WHERE assessment_type IN ('TMA', 'CMA')
      AND weight &gt; 0
    GROUP BY
        code_module,
        code_presentation
),
EvaluacionesPorMatricula AS
(
    SELECT
        a.code_module,
        a.code_presentation,
        sa.id_student,

        SUM(
            CASE
                WHEN sa.is_banked = 0 THEN 1
                ELSE 0
            END
        ) AS evaluaciones_entregadas,

        SUM(
            CASE
                WHEN sa.is_banked = 0
                 AND sa.score IS NOT NULL THEN 1
                ELSE 0
            END
        ) AS evaluaciones_calificadas,

        SUM(
            CASE
                WHEN sa.is_banked = 1 THEN 1
                ELSE 0
            END
        ) AS evaluaciones_convalidadas,

        SUM(
            CASE
                WHEN sa.is_banked = 0
                 AND sa.score IS NOT NULL
                THEN
                    CAST(sa.score AS DECIMAL(10,2))
                    * CAST(a.weight AS DECIMAL(10,2))
                ELSE 0
            END
        ) AS suma_notas_ponderadas,

        SUM(
            CASE
                WHEN sa.is_banked = 0
                 AND sa.score IS NOT NULL
                THEN CAST(a.weight AS DECIMAL(10,2))
                ELSE 0
            END
        ) AS suma_pesos

    FROM dbo.studentAssessment AS sa
    INNER JOIN dbo.assessments AS a
        ON a.id_assessment = sa.id_assessment

    WHERE a.assessment_type IN ('TMA', 'CMA')
      AND a.weight &gt; 0

    GROUP BY
        a.code_module,
        a.code_presentation,
        sa.id_student
),
ActividadVLE AS
(
    SELECT
        code_module,
        code_presentation,
        id_student,
        SUM(sum_click) AS clics_totales,
        COUNT(DISTINCT date) AS dias_activos
    FROM dbo.studentVle
    GROUP BY
        code_module,
        code_presentation,
        id_student
)
SELECT
    CAST(si.id_student AS INT) AS id_student,
    CAST(TRIM(si.age_band) AS VARCHAR(10)) AS age_band,

    CAST(TRIM(si.code_module) AS VARCHAR(3)) AS code_module,
    CAST(TRIM(si.code_presentation) AS VARCHAR(6))
        AS code_presentation,

    CAST(TRIM(si.final_result) AS VARCHAR(20)) AS final_result,

    CAST(
        COALESCE(sr.date_registration, -999)
        AS INT
    ) AS tiempo_alta_key,

    CAST(
        CASE
            WHEN sr.date_unregistration IS NOT NULL
                THEN sr.date_unregistration
            WHEN si.final_result = 'Withdrawn'
                THEN -999
            ELSE -998
        END
        AS INT
    ) AS tiempo_baja_key,

    CAST(si.studied_credits AS INT)
        AS creditos_matriculados,

    CAST(si.num_of_prev_attempts AS INT)
        AS intentos_previos,

    CAST(
        CASE
            WHEN sr.date_registration IS NOT NULL
             AND sr.date_unregistration IS NOT NULL
                THEN sr.date_unregistration - sr.date_registration
            ELSE NULL
        END
        AS INT
    ) AS dias_desde_alta_hasta_baja,

    CAST(COALESCE(ee.evaluaciones_esperadas, 0) AS INT)
        AS evaluaciones_esperadas,

    CAST(COALESCE(em.evaluaciones_entregadas, 0) AS INT)
        AS evaluaciones_entregadas,

    CAST(COALESCE(em.evaluaciones_calificadas, 0) AS INT)
        AS evaluaciones_calificadas,

    CAST(COALESCE(em.evaluaciones_convalidadas, 0) AS INT)
        AS evaluaciones_convalidadas,

    CAST(COALESCE(em.suma_notas_ponderadas, 0) AS DECIMAL(10,2))
        AS suma_notas_ponderadas,

    CAST(COALESCE(em.suma_pesos, 0) AS DECIMAL(10,2))
        AS suma_pesos,

    CAST(COALESCE(av.clics_totales, 0) AS INT)
        AS clics_totales,

    CAST(COALESCE(av.dias_activos, 0) AS INT)
        AS dias_activos

FROM dbo.studentInfo AS si

INNER JOIN dbo.studentRegistration AS sr
    ON sr.code_module = si.code_module
   AND sr.code_presentation = si.code_presentation
   AND sr.id_student = si.id_student

LEFT JOIN EvaluacionesEsperadas AS ee
    ON ee.code_module = si.code_module
   AND ee.code_presentation = si.code_presentation

LEFT JOIN EvaluacionesPorMatricula AS em
    ON em.code_module = si.code_module
   AND em.code_presentation = si.code_presentation
   AND em.id_student = si.id_student

LEFT JOIN ActividadVLE AS av
    ON av.code_module = si.code_module
   AND av.code_presentation = si.code_presentation
   AND av.id_student = si.id_student;</property>
                <property
