            <component
              refId="Package\FACT_ENTREGA_EVALUACION\Origen de OLE DB"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
              description="Origen de OLE DB"
              name="Origen de OLE DB"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH GrillaEvaluaciones AS
(
    SELECT
        si.id_student,
        si.age_band,
        si.code_module,
        si.code_presentation,

        a.id_assessment,
        a.assessment_type,
        a.[date] AS due_day,
        a.weight,

        c.module_presentation_length AS duracion_dias,

        sa.id_assessment AS entrega_existente,
        sa.date_submitted,
        sa.is_banked,
        sa.score

    FROM dbo.studentInfo AS si

    INNER JOIN dbo.assessments AS a
        ON a.code_module = si.code_module
       AND a.code_presentation = si.code_presentation

    INNER JOIN dbo.courses AS c
        ON c.code_module = si.code_module
       AND c.code_presentation = si.code_presentation

    LEFT JOIN dbo.studentAssessment AS sa
        ON sa.id_assessment = a.id_assessment
       AND sa.id_student = si.id_student
)
SELECT
    CAST(id_student AS INT) AS id_student,
    CAST(TRIM(age_band) AS VARCHAR(10)) AS age_band,

    CAST(TRIM(code_module) AS VARCHAR(3)) AS code_module,
    CAST(TRIM(code_presentation) AS VARCHAR(6))
        AS code_presentation,

    CAST(id_assessment AS INT) AS id_assessment,

    CAST(
        COALESCE(date_submitted, -999)
        AS INT
    ) AS tiempo_entrega_key,

    CAST(
        CASE
            WHEN is_banked = 1
                THEN 'Convalidado'
            WHEN entrega_existente IS NULL
                THEN 'No entregado'
            WHEN due_day IS NULL
                THEN 'Sin fecha'
            WHEN date_submitted &gt; due_day
                THEN 'Tarde'
            ELSE 'A tiempo'
        END
        AS VARCHAR(20)
    ) AS estado,

    CAST(
        CASE
            WHEN is_banked = 1
                THEN 'Convalidado'
            WHEN score IS NULL
                THEN 'Sin nota'
            WHEN score &lt; 40
                THEN 'Desaprobado'
            ELSE 'Aprobado'
        END
        AS VARCHAR(20)
    ) AS resultado_evaluacion,

    CAST(score AS DECIMAL(5,2)) AS score,

    CAST(
        CASE
            WHEN is_banked = 0
             AND score IS NOT NULL
                THEN score * weight / 100.0
            ELSE NULL
        END
        AS DECIMAL(6,2)
    ) AS score_ponderado,

    CAST(
        CASE
            WHEN date_submitted IS NOT NULL
             AND due_day IS NOT NULL
                THEN date_submitted - due_day
            ELSE NULL
        END
        AS INT
    ) AS days_late,

    CAST(
        CASE
            WHEN date_submitted IS NOT NULL
             AND due_day IS NULL
             AND TRIM(assessment_type) = 'Exam'
                THEN date_submitted - duracion_dias
            ELSE NULL
        END
        AS INT
    ) AS days_late_estimado

FROM GrillaEvaluaciones;</property>
