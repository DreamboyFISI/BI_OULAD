        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/sqlserver-jcbi database windows net;DM1_RendimientoAcad\",",
                "    dm1_FACT_RESULTADO_ACADEMICO = Source{[Schema=\"dm1\",Item=\"FACT_RESULTADO_ACADEMICO\"]}[Data]",
                "in",
                "    dm1_FACT_RESULTADO_ACADEMICO"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Matrículas",
            "expression": [
              "",
              "COUNTROWS(FACT_RESULTADO_ACADEMICO)"
            ],
            "displayFolder": "1. Volumen",
            "formatString": "#,0"
          },
          {
            "name": "Matrículas Aprobadas",
            "expression": [
              "",
              "CALCULATE(",
              "    [Matrículas],",
              "    DIM_RESULTADO[es_aprobado] = \"Si\"",
              ")"
            ],
            "displayFolder": "1. Volumen",
            "formatString": "#,0"
          },
          {
            "name": "Tasa de Aprobación",
            "expression": [
              "",
              "DIVIDE(",
              "    [Matrículas Aprobadas],",
              "    [Matrículas]",
              ")"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "2. Resultados",
            "description": "Pass + Distinction sobre el total de matrículas. Aprobación + Reprobación + Deserción = 100%."
          },
          {
            "name": "Matrículas Retiradas",
            "expression": [
              "",
              "CALCULATE(",
              "    [Matrículas],",
              "    DIM_RESULTADO[es_retirado] = \"Si\"",
              ")"
            ],
            "displayFolder": "1. Volumen",
            "formatString": "#,0"
          },
          {
            "name": "Tasa de Deserción",
            "expression": [
              "",
              "DIVIDE(",
              "    [Matrículas Retiradas],",
              "    [Matrículas]",
              ")"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "2. Resultados"
          },
          {
            "name": "Matrículas Reprobadas",
            "expression": [
              "",
              "CALCULATE(",
              "    [Matrículas],",
              "    DIM_RESULTADO[es_reprobado] = \"Si\"",
              ")"
            ],
            "displayFolder": "1. Volumen",
            "formatString": "#,0"
          },
          {
            "name": "Tasa de Reprobación",
            "expression": [
              "",
              "DIVIDE(",
              "    [Matrículas Reprobadas],",
              "    [Matrículas]",
              ")"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "2. Resultados"
          },
          {
            "name": "Matrículas con Distinción",
            "expression": [
              "",
              "CALCULATE(",
              "    [Matrículas],",
              "    DIM_RESULTADO[es_distincion] = \"Si\"",
              ")"
            ],
            "displayFolder": "1. Volumen",
            "formatString": "#,0"
          },
          {
            "name": "Tasa de Distinción",
            "expression": [
              "",
              "DIVIDE(",
              "    [Matrículas con Distinción],",
              "    [Matrículas]",
              ")"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "2. Resultados",
            "description": "Subconjunto de la Tasa de Aprobación (solo Distinction); no se suma a las otras tasas."
          },
          {
            "name": "Nota Media Ponderada",
            "expression": [
              "",
              "DIVIDE(",
              "    SUM(FACT_RESULTADO_ACADEMICO[suma_notas_ponderadas]),",
              "    SUM(FACT_RESULTADO_ACADEMICO[suma_pesos])",
              ")"
            ],
            "displayFolder": "2. Resultados",
            "formatString": "0.0"
          },
          {
            "name": "Tasa de Entrega",
            "expression": [
              "",
              "DIVIDE(",
              "    SUM(FACT_RESULTADO_ACADEMICO[evaluaciones_entregadas]),",
              "    SUM(FACT_RESULTADO_ACADEMICO[evaluaciones_esperadas])",
              ")"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "3. Evaluaciones"
          },
          {
            "name": "Tasa de Calificación",
            "expression": [
              "",
              "DIVIDE(",
              "    SUM(FACT_RESULTADO_ACADEMICO[evaluaciones_calificadas]),",
              "    SUM(FACT_RESULTADO_ACADEMICO[evaluaciones_entregadas])",
              ")"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "displayFolder": "3. Evaluaciones"
          },
          {
            "name": "Clics Totales",
            "expression": [
              "",
              "SUM(FACT_RESULTADO_ACADEMICO[clics_totales])"
            ],
            "displayFolder": "4. Participación",
            "formatString": "#,0"
          },
          {
            "name": "Clics por Matrícula",
            "expression": [
              "",
              "DIVIDE(",
              "    [Clics Totales],",
              "    [Matrículas]",
              ")"
            ],
            "displayFolder": "4. Participación",
            "formatString": "#,0.0"
          },
          {
            "name": "Estudiantes",
            "expression": "CALCULATE(DISTINCTCOUNT(DIM_ESTUDIANTE[id_student]), FACT_RESULTADO_ACADEMICO)",
            "formatString": "#,0",
            "displayFolder": "1. Volumen"
          },
          {
            "name": "Días Activos Promedio",
            "expression": "AVERAGE(FACT_RESULTADO_ACADEMICO[dias_activos])",
            "formatString": "0.0",
            "displayFolder": "4. Participación"
          },
          {
            "name": "Créditos Promedio",
            "expression": "AVERAGE(FACT_RESULTADO_ACADEMICO[creditos_matriculados])",
            "formatString": "0.0",
            "displayFolder": "5. Perfil académico"
          },
          {
            "name": "Intentos Previos Promedio",
            "expression": "AVERAGE(FACT_RESULTADO_ACADEMICO[intentos_previos])",
            "formatString": "0.00",
            "displayFolder": "5. Perfil académico"
          },
          {
            "name": "Días hasta la Baja Promedio",
            "expression": "CALCULATE(AVERAGE(FACT_RESULTADO_ACADEMICO[dias_desde_alta_hasta_baja]), DIM_RESULTADO[es_retirado] = \"Si\")",
            "formatString": "0.0",
            "displayFolder": "4. Participación"
          }
        ]
      }
    ],
