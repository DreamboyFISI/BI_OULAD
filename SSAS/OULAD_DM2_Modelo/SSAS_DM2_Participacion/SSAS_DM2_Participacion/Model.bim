            "sourceColumn": "tiempo_key"
          },
          {
            "name": "sitio_key",
            "dataType": "int64",
            "sourceColumn": "sitio_key"
          },
          {
            "name": "sum_click",
            "dataType": "int64",
            "sourceColumn": "sum_click"
          },
          {
            "name": "num_eventos",
            "dataType": "int64",
            "sourceColumn": "num_eventos"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/sqlserver-jcbi database windows net;DM1_RendimientoAcad\",",
                "    dm2_FACT_INTERACCION_VLE = Source{[Schema=\"dm2\",Item=\"FACT_INTERACCION_VLE\"]}[Data]",
                "in",
                "    dm2_FACT_INTERACCION_VLE"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "% del Total de Clics",
            "expression": "DIVIDE([Clics Totales], CALCULATE([Clics Totales], ALLSELECTED(DIM_SITIO_VLE)))",
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "% Pre-curso",
            "expression": "DIVIDE([Clics Pre-curso], [Clics Totales])",
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "Clics por Estudiante",
            "expression": "DIVIDE([Clics Totales], [Estudiantes Activos])",
            "formatString": "0"
          },
          {
            "name": "Clics por Evento",
            "expression": "DIVIDE([Clics Totales], [Eventos])",
            "formatString": "0.00"
          },
          {
            "name": "Clics por Matrícula",
            "expression": "DIVIDE([Clics Totales], [Matrículas Activas])",
            "formatString": "0.00"
          },
          {
            "name": "Clics Pre-curso",
            "expression": "CALCULATE([Clics Totales], DIM_TIEMPO[dia_offset] < 0)"
          },
          {
            "name": "Clics Totales",
            "expression": "SUM(FACT_INTERACCION_VLE[sum_click])"
          },
          {
            "name": "Días Activos Promedio",
            "expression": "DIVIDE(COUNTROWS(SUMMARIZE(FACT_INTERACCION_VLE, FACT_INTERACCION_VLE[student_key], FACT_INTERACCION_VLE[curso_key], FACT_INTERACCION_VLE[tiempo_key])), [Matrículas Activas])",
            "formatString": "0.00"
          },
          {
            "name": "Estudiantes Activos",
            "expression": "CALCULATE(DISTINCTCOUNT(DIM_ESTUDIANTE[id_student]), FACT_INTERACCION_VLE)"
          },
          {
            "name": "Eventos",
            "expression": "SUM(FACT_INTERACCION_VLE[num_eventos])"
          },
          {
            "name": "Matrículas Activas",
            "expression": "COUNTROWS(SUMMARIZE(FACT_INTERACCION_VLE, FACT_INTERACCION_VLE[student_key], FACT_INTERACCION_VLE[curso_key]))"
          },
          {
            "name": "Sitios Visitados",
            "expression": "DISTINCTCOUNT(FACT_INTERACCION_VLE[sitio_key])"
          }
        ]
      },
