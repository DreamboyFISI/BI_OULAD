            "dataType": "double",
            "sourceColumn": "score_ponderado"
          },
          {
            "name": "days_late",
            "dataType": "int64",
            "sourceColumn": "days_late"
          },
          {
            "name": "days_late_estimado",
            "dataType": "int64",
            "sourceColumn": "days_late_estimado"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/sqlserver-jcbi database windows net;DM1_RendimientoAcad\",",
                "    dm3_FACT_ENTREGA_EVALUACION = Source{[Schema=\"dm3\",Item=\"FACT_ENTREGA_EVALUACION\"]}[Data]",
                "in",
                "    dm3_FACT_ENTREGA_EVALUACION"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "% del Total",
            "expression": "DIVIDE([Entregas], CALCULATE([Entregas], ALL(DIM_ESTADO_ENTREGA)))",
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "Entregas",
            "expression": "COUNTROWS(FACT_ENTREGA_EVALUACION)"
          },
          {
            "name": "Cursos",
            "expression": "DISTINCTCOUNT(FACT_ENTREGA_EVALUACION[curso_key])"
          },
          {
            "name": "Entregas con Fecha",
            "expression": "CALCULATE([Entregas], DIM_ESTADO_ENTREGA[es_puntual] = \"Si\") + CALCULATE([Entregas], DIM_ESTADO_ENTREGA[es_tarde] = \"Si\")"
          },
          {
            "name": "Entregas Convalidadas",
            "expression": "CALCULATE([Entregas], DIM_ESTADO_ENTREGA[es_banked] IN {\"Si\",\"Sí\",\"1\"})"
          },
          {
            "name": "Entregas Esperadas",
            "expression": "CALCULATE([Entregas], DIM_ESTADO_ENTREGA[es_banked] = \"No\")"
          },
          {
            "name": "Entregas por Estudiante",
            "expression": "DIVIDE([Entregas], [Estudiantes])",
            "formatString": "0.00"
          },
          {
            "name": "Estudiantes",
            "expression": "DISTINCTCOUNT(DIM_ESTUDIANTE[id_student])"
          },
          {
            "name": "Evaluaciones",
            "expression": "DISTINCTCOUNT(DIM_EVALUACION[id_assessment])"
          },
          {
            "name": "% No Entrega",
            "expression": "DIVIDE([No Entregadas], [Entregas Esperadas])",
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "% Puntualidad",
            "expression": "DIVIDE([Entregas Puntuales], [Entregas con Fecha])",
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "% Tardías",
            "expression": "DIVIDE([Entregas Tardías], [Entregas con Fecha])",
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "Entregas Puntuales",
            "expression": "CALCULATE([Entregas], DIM_ESTADO_ENTREGA[es_puntual] IN {\"Si\",\"Sí\",\"1\"})"
          },
          {
            "name": "Entregas Tardías",
            "expression": "CALCULATE([Entregas], DIM_ESTADO_ENTREGA[es_tarde] IN {\"Si\",\"Sí\",\"1\"})"
          },
          {
            "name": "No Entregadas",
            "expression": "CALCULATE([Entregas], DIM_ESTADO_ENTREGA[es_no_entregado] IN {\"Si\",\"Sí\",\"1\"})"
          },
          {
            "name": "Días de Retraso Promedio",
            "expression": "AVERAGE(FACT_ENTREGA_EVALUACION[days_late])",
            "formatString": "0.00"
          },
          {
            "name": "Retraso Promedio Tardías",
            "expression": "CALCULATE(AVERAGE(FACT_ENTREGA_EVALUACION[days_late]), DIM_ESTADO_ENTREGA[es_tarde] = \"Si\")",
            "formatString": "0.00"
          },
          {
            "name": "Entregas Aprobadas",
            "expression": "CALCULATE([Entregas], DIM_RESULTADO_EVALUACION[es_aprobado] IN {\"Si\",\"Sí\",\"1\"})"
          },
          {
            "name": "Entregas Calificadas",
            "expression": "CALCULATE([Entregas], DIM_RESULTADO_EVALUACION[es_calificado] IN {\"Si\",\"Sí\",\"1\"})"
          },
          {
            "name": "Entregas Desaprobadas",
            "expression": "CALCULATE([Entregas], DIM_RESULTADO_EVALUACION[es_desaprobado] IN {\"Si\",\"Sí\",\"1\"})"
          },
          {
            "name": "Nota Ponderada Promedio",
            "expression": "AVERAGE(FACT_ENTREGA_EVALUACION[score_ponderado])",
            "formatString": "0.00"
          },
          {
            "name": "Nota Promedio",
            "expression": "AVERAGE(FACT_ENTREGA_EVALUACION[score])",
            "formatString": "0.00"
          },
          {
            "name": "Tasa de Aprobación",
            "expression": "DIVIDE([Entregas Aprobadas], [Entregas Calificadas])",
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "% Puntualidad (semana)",
            "expression": "CALCULATE([% Puntualidad], DIM_TIEMPO[es_desconocido] <> \"Si\")",
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "Entregas con Fecha (semana)",
            "expression": "CALCULATE([Entregas con Fecha], DIM_TIEMPO[es_desconocido] <> \"Si\")"
          }
        ]
      },
