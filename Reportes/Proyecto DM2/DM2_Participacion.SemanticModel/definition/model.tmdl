model Model
	culture: es-PE
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-PE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["ServidorSQL", "BaseDatos", "comun DIM_ESTUDIANTE", "comun DIM_CURSO", "comun DIM_TIEMPO", "dm2 DIM_SITIO_VLE", "dm2 FACT_INTERACCION_VLE"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'comun DIM_ESTUDIANTE'
ref table 'comun DIM_CURSO'
ref table 'comun DIM_TIEMPO'
ref table 'dm2 DIM_SITIO_VLE'
ref table 'dm2 FACT_INTERACCION_VLE'

ref cultureInfo es-PE

